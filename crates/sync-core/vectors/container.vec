# Object container (spec §3) open-direction known answers, suite 0x02, fmt 0x01.
# Generated once on the AWS-LC FIPS module (sync-core tests/object.rs
# gen_container_kat, commit 58a0368); nonces are module-chosen, so sealing is
# not reproducible — readers MUST open these bytes to exactly `body`.
# k_root = 00..1f, vault_id = 11*16, obj_id = 22*16. The header commitment is
# also recomputed with the independent sha2-based SoftProvider.
format = osy-vec-1
area = container
suite = 02

[batch-raw]
k_root = 000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
vault_id = 11111111111111111111111111111111
obj_id = 22222222222222222222222222222222
kind = 01
comp = 00
body = 6f737920636f6e7461696e6572206b6174207631
container = 4f53594e01020000222222222222222222222222222222220c9b9fdae82df20fbc4668ae8c60a081806693ad49093c8be8862204daee46cccbcc6bda825c96b0ea277a31c3b433ad4dfe3bed86a213a0bbf83924c6811841c7f6874fdd3cfdae29ec44e562ac846683d18b2783ccf11a3eda
