set-editor-fold-heading = 折叠标题
set-editor-fold-heading-desc = 允许折叠某个标题下的全部内容。
set-editor-fold-indent = 折叠缩进
set-editor-fold-indent-desc = 允许折叠缩进的部分，例如列表。
set-editor-line-numbers = 行号
set-editor-line-numbers-desc = 在边栏中显示行号。
set-editor-indentation-guides = 缩进参考线
