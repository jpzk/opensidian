# SPDX-License-Identifier: GPL-3.0-or-later
# RELEASE BUILD PINS for .github/workflows/release.yml (GitHub-hosted ubuntu-24.04).
# The same inputs the box release path uses (harness bin/hz/cloud-init.yaml,
# scripts/build-appimage.sh, bin/hz/{rpm,deb,flatpak}-build.sh), frozen so that
# nothing the CI build installs was released after 2026-09-14 (6-week rule).
# Sourced by packaging/ci/*.sh. Changing a value here changes the release
# inputs: re-measure, keep the date comment, never point at a moving tip.

# ---- AppImage build environment (packaging/ci/appimage.sh) ----
# ubuntu:noble-20260905 (24.04, the box's distro), manifest-list digest, Docker Hub last_updated 2026-09-09.
UBUNTU_IMG=docker.io/library/ubuntu@sha256:a053cbffda9d424679c103c5b4f452297efc3774a1e491c110289f726fbb5d34
# apt reads ONLY this frozen archive: noble, noble-updates, noble-security as of the cutoff.
# Measured: libwebkit2gtk-4.1-dev 2.52.6-0ubuntu0.24.04.1 here == the box's installed version.
UBUNTU_SNAPSHOT=20260914T000000Z
# the box's cloud-init `packages:` build set (+ file, xz, ca-certificates the image lacks,
# squashfs-tools for the brotli-check gate in appimage.sh)
UBUNTU_PKGS="build-essential curl git pkg-config libssl-dev libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev patchelf file xz-utils ca-certificates perl binutils squashfs-tools"
# rustup-init 1.29.1 (tag commit 2026-08-13), sha256 from static.rust-lang.org/rustup/archive/1.29.1/.../rustup-init.sha256
RUSTUP_VER=1.29.1
RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
# toolchain = the box's pin (cloud-init: --default-toolchain 1.98.0), channel date 2026-08-20
RUST_TOOLCHAIN=1.98.0
# appimagetool r13 — same URL + sha256 as cloud-init.yaml (AppImageKit is archived upstream)
APPIMAGETOOL_URL=https://github.com/AppImage/AppImageKit/releases/download/13/obsolete-appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=df3baf5ca5facbecfc2f3fa6713c29ab9cefa8fd8c1eac5d283b79cab33e4acb
# (brotli 1.2.1 tarball + sha256 are pinned inside packaging/ci/build-appimage.sh, unchanged)

# ---- RPM (packaging/ci/rpm.sh) — identical to bin/hz/rpm-build.sh ----
FEDORA_OCI_URL=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Container/x86_64/images/Fedora-Container-Base-Generic-44-1.7.x86_64.oci.tar.xz
FEDORA_OCI_SHA256=75200f5752a74a21a616ca9a75e25beb594e2e117a0195c54f87c0b3e3974d1b
FEDORA_DIGEST=sha256:f1e66cdd6eff2c9ccad192f8865af9be6d69b46b3f13329d2975a2d61a1296c5
FEDORA_TOOLS="rpm-build-6.0.1-2.fc44 rpmlint-2.8.0-3.fc44 desktop-file-utils-0.28-5.fc44 libappstream-glib-0.8.3-5.fc44 cpio-2.15-9.fc44"

# ---- DEB (packaging/ci/deb.sh) — identical to bin/hz/deb-build.sh ----
DEBIAN_IMG=docker.io/library/debian@sha256:34cd9e9fd437c0a095ec39cb2e73422c9f30821b0d0848ed74fd0d43bae4d958
DEBIAN_SNAPSHOT=20260803T000000Z
DEBIAN_TOOLS="dpkg-dev=1.22.22 lintian=2.122.0 libwebkit2gtk-4.1-0=2.52.3-2~deb13u1"

# ---- Flatpak (packaging/ci/flatpak.sh) ----
# flatpak + flatpak-builder: the cloud-init versions, from the same ubuntu snapshot as above.
FLATPAK_VER=1.14.6-1ubuntu0.1
FLATPAK_BUILDER_VER=1.4.2-1build2
# Runtimes PINNED BY COMMIT (the box pins by branch only). rust-stable//25.08 commit = the box's,
# 2026-09-07. GNOME 49 Platform/Sdk: EXCEPTION to the cutoff — flathub prunes history and the
# oldest commit still served is 2026-09-19 (its parent answers 404, measured 2026-10-26). These are
# the oldest reachable, 2 weeks OLDER than the box's (2026-10-03). Platform is not shipped in the bundle.
FP_PLATFORM_COMMIT=56c74fabc56c768711b02af74e202229ccf184474e1bea7d71c0fa8980d664d2
FP_SDK_COMMIT=d316a6c7b8d8689054a5ada2dffe3730e3b247ac8f856e9760534abd35b99a86
FP_RUST_COMMIT=09784a9989ae5a7fda6a2280033ca9aa32aac6907961da8b18be4590dd261507
