dist/
.cov-evidence/

# per-worktree goal state (display, HOME, TMPDIR). Generated by goal-scaffold.
# NEVER tracked: a committed .goalenv merges into another goal and `cd`s it
# into the WRONG worktree — that happened 2026-09-12 (drop-attach -> main ->
# inline-title), which is how a goal ends up building in a peer's tree.
.goalenv

# The test/gate harness (scripts/), the recon + design docs (docs/), the
# working notes (notes/) and the coordinator box scripts (bin/) are NOT part
# of this repository (operator 2026-10-02).
# They are versioned in a separate, local-only harness repo and appear here as
# symlinks into its worktree. No trailing slash: a symlink is not a directory to
# gitignore, and a directory-only pattern would let `git add -A` pick the links up.
# Fixtures `cargo test` needs live under src-tauri/ (tests/fixtures/, data/).
/scripts
/docs
/notes
/bin
